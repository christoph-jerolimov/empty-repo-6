---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Hello World snippets, history and links for major programming languages.' } =
  Astro.props;

const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href={base}>Hello, World!</a>
        <nav>
          <a href={base}>Languages</a>
          <a href={`${base}about/`}>About</a>
          <a href="https://github.com/christoph-jerolimov/empty-repo-6" rel="noopener">Source</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="inner">
        Built with <a href="https://astro.build" rel="noopener">Astro</a> and deployed on GitHub Pages. Code snippets
        and descriptions are provided for educational purposes.
      </div>
    </footer>
  </body>
</html>
